# Token personal de GitHub (opcional pero recomendado).
# Sin token:  60 peticiones/hora por IP  -> ~12 analisis/hora
# Con token:  5000 peticiones/hora       -> ~1000 analisis/hora
#
# Crear en: https://github.com/settings/tokens
# Tipo: "Fine-grained" o "Classic" SIN marcar ningun scope
# (solo necesitamos leer datos publicos).
#
# Copia este archivo como .env y pega tu token:
GITHUB_TOKEN=

# Segundos que se reutiliza un analisis ya calculado, sin volver a preguntar
# a GitHub. Con 0 la cache queda desactivada. Por defecto: 300 (5 minutos).
CACHE_TTL_SECONDS=300

# Dias naturales (en UTC) que abarca el analisis de actividad, contando hoy.
# Es el valor por defecto: cada peticion puede cambiarlo con ?activity_days=N.
# Ojo: la actividad se calcula sobre los commits, issues, pull requests y
# releases que ya se analizan, que son muestras limitadas. En un repositorio
# muy activo los totales son un minimo, no la cifra real del periodo.
ACTIVITY_DAYS=30
