# Token personal de GitHub (opcional pero recomendado).
# Sin token:  60 peticiones/hora por IP  -> ~12 analisis/hora
# Con token:  5000 peticiones/hora       -> ~1000 analisis/hora
#
# Crear en: https://github.com/settings/tokens
# Tipo: "Fine-grained" o "Classic" SIN marcar ningun scope
# (solo necesitamos leer datos publicos).
#
# Copia este archivo como .env y pega tu token:
GITHUB_TOKEN=

# Segundos que se reutiliza un analisis ya calculado, sin volver a preguntar
# a GitHub. Con 0 la cache queda desactivada. Por defecto: 300 (5 minutos).
CACHE_TTL_SECONDS=300

# Dias naturales (en UTC) que abarca el analisis de actividad, contando hoy.
# Es el valor por defecto: cada peticion puede cambiarlo con ?activity_days=N.
# Ojo: la actividad se calcula sobre los commits, issues, pull requests y
# releases que ya se analizan, que son muestras limitadas. En un repositorio
# muy activo los totales son un minimo, no la cifra real del periodo.
ACTIVITY_DAYS=30

# Origenes permitidos por CORS, separados por comas y sin espacios.
# Solo aplican a llamadas directas al backend (Swagger, curl, `npm run dev`):
# a traves del nginx de Docker la peticion es del mismo origen y no usa CORS.
# En produccion pon aqui el dominio real. Nunca se usa "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Configuracion de Inteligencia Artificial (opcional).
# Compatible con cualquier proveedor con API compatible con OpenAI (OpenAI, Groq, Ollama, etc.).
# Si AI_API_KEY no se define, el analisis de GitHub funciona normalmente y ai_analysis es null.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30.0

# --- Frontend (build) -------------------------------------------------------
# ATENCION: las variables VITE_* se incrustan en el bundle durante el build y
# son PUBLICAS para cualquiera que abra la aplicacion en el navegador.
# Nunca pongas aqui tokens ni claves de API.
# Dejalo vacio con Docker Compose: el frontend llama a rutas relativas y nginx
# las reenvia al backend.
VITE_API_BASE_URL=
