# URL base del backend de AI-Code-Analyzer.
# Dejala VACIA para que el frontend haga peticiones relativas al mismo origen:
# asi funcionan tanto el proxy de Vite en desarrollo como nginx en Docker.
# Rellenala solo si el backend vive en otro dominio, y entonces con su URL
# PUBLICA, la que alcanza el navegador del visitante (nunca localhost ni un
# hostname interno de Docker como http://backend:8000).
# ATENCION: las variables VITE_* se incrustan en el bundle durante el build y
# son PUBLICAS para cualquiera que abra la aplicacion. Nunca pongas en ellas
# tokens ni claves de API.
VITE_API_BASE_URL=
